{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pagelingo-web-document-bundle/1"
    },
    "packageId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "manifestPath": {
          "type": "string",
          "const": "source/manifest.json"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "manifestPath",
        "manifestSha256",
        "snapshotSha256",
        "contentFingerprint"
      ],
      "additionalProperties": false
    },
    "originals": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "capture": {
              "type": "object",
              "properties": {
                "manifestSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "requestSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "admissionKind": {
                  "type": "string",
                  "enum": [
                    "upload",
                    "fetch"
                  ]
                }
              },
              "required": [
                "manifestSha256",
                "requestSha256",
                "admissionKind"
              ],
              "additionalProperties": false
            },
            "readerCapture": {
              "type": "object",
              "properties": {
                "manifestSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "requestSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "admissionKind": {
                  "type": "string",
                  "enum": [
                    "upload",
                    "fetch"
                  ]
                },
                "translationSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sharedFiles": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "sourceFileId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      }
                    },
                    "required": [
                      "id",
                      "sourceFileId"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "manifestSha256",
                "requestSha256",
                "admissionKind",
                "translationSha256",
                "sharedFiles"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "capture"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "github": {
              "type": "object",
              "properties": {
                "sourceManifestSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "revision": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "github"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "sourceVersionId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "repository": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        },
                        "owner": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "url": {
                          "type": "string",
                          "maxLength": 8192,
                          "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#\\s\\x00-\\x1f\\x7f]+[^\\s\\x00-\\x1f\\x7f]*$"
                        }
                      },
                      "required": [
                        "id",
                        "owner",
                        "name",
                        "description",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    "commitSha": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "readme": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "blobSha": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{40}$"
                            },
                            "raw": {
                              "type": "object",
                              "properties": {
                                "assetId": {
                                  "type": "string",
                                  "format": "uuid",
                                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                },
                                "sha256": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                },
                                "bytes": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "mediaType": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "filename": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "assetId",
                                "sha256",
                                "bytes",
                                "mediaType",
                                "filename"
                              ],
                              "additionalProperties": false
                            },
                            "renderedHtml": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "assetId": {
                                      "type": "string",
                                      "format": "uuid",
                                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                    },
                                    "sha256": {
                                      "type": "string",
                                      "pattern": "^[a-f0-9]{64}$"
                                    },
                                    "bytes": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    "mediaType": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "filename": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "assetId",
                                    "sha256",
                                    "bytes",
                                    "mediaType",
                                    "filename"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "path",
                            "blobSha",
                            "raw",
                            "renderedHtml"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "capturedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "sourceVersionId",
                    "repository",
                    "commitSha",
                    "readme",
                    "capturedAt"
                  ],
                  "additionalProperties": false
                },
                "jobId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "files": {
                  "minItems": 1,
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "assetId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "role": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,99}$"
                      },
                      "url": {
                        "type": "string",
                        "maxLength": 8192,
                        "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#\\s\\x00-\\x1f\\x7f]+[^\\s\\x00-\\x1f\\x7f]*$"
                      },
                      "filename": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777216
                      },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "assetId",
                      "role",
                      "url",
                      "filename",
                      "sha256",
                      "bytes",
                      "mediaType"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sourceManifestSha256",
                "revision",
                "jobId",
                "files"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "github"
          ],
          "additionalProperties": false
        }
      ]
    },
    "parse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p_[a-f0-9]{64}$"
        },
        "readerIrSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "readerIrSha256"
      ],
      "additionalProperties": false
    },
    "translation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "const": "translation.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "not-required",
                "pending",
                "partial",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "generationKind": {
              "type": "string",
              "enum": [
                "model",
                "mock",
                "none",
                "import"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "status",
            "generationKind"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "renderer": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "codeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "codeSha256"
      ],
      "additionalProperties": false
    },
    "files": {
      "maxItems": 9999,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "allOf": [
              {
                "pattern": "^[\\x20-\\x7e]+$"
              },
              {
                "pattern": "^[^\\\\:%\"*<>?|]+$"
              },
              {
                "pattern": "^(?!\\/)(?!.*\\/$)(?!.*\\/\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*(?:^|\\/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9]|[lL][pP][tT][0-9])(?:\\.|\\/|$))(?!.*(?:[. ]\\/|[. ]$)).+$"
              }
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "source",
              "reader-ir",
              "translation",
              "render",
              "asset",
              "provenance",
              "license"
            ]
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "mediaType",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "createdAt",
    "title",
    "source",
    "parse",
    "translation",
    "renderer",
    "files"
  ],
  "additionalProperties": false,
  "$id": "https://pagelingo.dev/schemas/web-document-bundle/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
