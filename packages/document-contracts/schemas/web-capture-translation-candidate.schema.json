{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "web-capture-translation-candidate/1"
    },
    "sourceSnapshotSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceContentFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceLanguage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 63,
          "pattern": "^(?!(?:[uU][nN][dD]|[mM][uU][lL]|[zZ][xX][xX])(?:-|$))[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetLanguage": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^(?!(?:[uU][nN][dD]|[mM][uU][lL]|[zZ][xX][xX])(?:-|$))[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "protectionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "blocks": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sourceTextSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of UTF-8 naturalText(source.content), without whitespace normalization."
          },
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "paragraph",
                  "heading",
                  "list-item",
                  "quote",
                  "caption",
                  "table-cell"
                ]
              },
              "sectionPath": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "content": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "content"
            ],
            "additionalProperties": false
          },
          "rawText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 524288
          }
        },
        "required": [
          "nodeId",
          "sourceTextSha256",
          "source",
          "rawText"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sourceSnapshotSha256",
    "sourceContentFingerprint",
    "sourceLanguage",
    "targetLanguage",
    "sdkVersion",
    "promptVersion",
    "protectionVersion",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "protected"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "code",
                "math",
                "citation",
                "identifier",
                "url",
                "literal"
              ]
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "kind",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "format"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "strong",
                "emphasis",
                "link",
                "subscript",
                "superscript",
                "deletion",
                "small",
                "mark",
                "underline",
                "style"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "id",
            "kind",
            "children"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://pagelingo.dev/schemas/web-capture-translation-candidate/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
