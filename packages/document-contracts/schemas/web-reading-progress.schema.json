{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "position": {
      "type": "object",
      "properties": {
        "readerVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sourceVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "parseId": {
          "type": "string",
          "pattern": "^p_[a-f0-9]{64}$"
        },
        "blockId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^b_[a-f0-9]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockOffset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "view": {
          "type": "string",
          "enum": [
            "content",
            "snapshot"
          ]
        },
        "contentMode": {
          "type": "string",
          "enum": [
            "source",
            "translation",
            "bilingual"
          ]
        }
      },
      "required": [
        "readerVersionId",
        "sourceVersionId",
        "parseId",
        "blockId",
        "blockOffset",
        "view",
        "contentMode"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "position",
    "revision",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://pagelingo.dev/schemas/web-reading-progress/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
