{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceVersionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "parseId": {
      "type": "string",
      "pattern": "^p_[a-f0-9]{64}$"
    },
    "profileRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "glossaryRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "selectionBlockIds": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^b_[a-f0-9]{32}$"
      }
    }
  },
  "required": [
    "sourceVersionId",
    "parseId",
    "profileRevision",
    "glossaryRevision"
  ],
  "additionalProperties": false,
  "$id": "https://pagelingo.dev/schemas/web-job-request/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
