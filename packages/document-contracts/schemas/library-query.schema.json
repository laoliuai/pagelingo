{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        {
          "type": "string",
          "pattern": "^0*(?:[1-9][0-9]{0,5}|1000000)$"
        }
      ]
    },
    "pageSize": {
      "default": 20,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "string",
          "pattern": "^0*(?:[1-9][0-9]?|100)$"
        }
      ]
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "pdf",
        "article",
        "x-post",
        "repository",
        "paper"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "upload",
        "web",
        "x",
        "zhihu",
        "wechat",
        "github",
        "arxiv"
      ]
    },
    "readingStatus": {
      "type": "string",
      "enum": [
        "unread",
        "reading",
        "read"
      ]
    },
    "collectionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "string",
          "const": "none"
        }
      ]
    },
    "tagIds": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "uniqueItems": true
        }
      ]
    }
  },
  "additionalProperties": false,
  "$id": "https://pagelingo.dev/schemas/library-query/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
