  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "translationIntent": {
      "type": "string",
      "enum": [
        "auto",
        "none"
      ]
    }
  },
  "required": [
