{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "requestedRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#\\s\\x00-\\x1f\\x7f]+[^\\s\\x00-\\x1f\\x7f]*$"
        }
      },
      "required": [
        "provider",
        "owner",
        "repo",
        "url"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "arxiv"
        },
        "baseId": {
          "type": "string",
          "pattern": "^(?:[0-9]{4}\\.[0-9]{4,5}|[a-zA-Z][a-zA-Z0-9.-]*\\/[0-9]{7})$"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#\\s\\x00-\\x1f\\x7f]+[^\\s\\x00-\\x1f\\x7f]*$"
        }
      },
      "required": [
        "provider",
        "baseId",
        "version",
        "url"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://pagelingo.dev/schemas/source-reference/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
