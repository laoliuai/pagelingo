{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "const": "zh"
        },
        "sourceLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 63,
          "allOf": [
            {
              "pattern": "^(?!(?:[uU][nN][dD]|[mM][uU][lL]|[zZ][xX][xX])(?:-|$))[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            {
              "pattern": "^[zZ][hH](?:-|$)"
            }
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "no-language",
            "han-only",
            "insufficient-text",
            "other-script",
            "han-majority",
            "mixed-script",
            "english-heuristic",
            "uncertain",
            "document-inherited",
            "user-specified",
            "script-compatible-hint"
          ]
        }
      },
      "required": [
        "language",
        "sourceLanguage",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "const": "en"
        },
        "sourceLanguage": {
          "type": "string",
          "minLength": 2,
