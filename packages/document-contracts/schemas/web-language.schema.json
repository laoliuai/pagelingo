            },
            {
              "pattern": "^[eE][nN](?:-|$)"
            }
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "no-language",
            "han-only",
            "insufficient-text",
            "other-script",
            "han-majority",
            "mixed-script",
            "english-heuristic",
            "uncertain",
            "document-inherited",
            "user-specified",
            "script-compatible-hint"
          ]
        }
      },
      "required": [
        "language",
        "sourceLanguage",
        "reason"
      ],
      "additionalProperties": false
    },
