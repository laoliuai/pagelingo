{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "zh",
        "en",
        "foreign",
        "mixed",
        "und"
      ]
    },
    "sourceLanguage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 63,
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "no-language",
        "han-only",
        "insufficient-text",
        "other-script",
        "han-majority",
        "mixed-script",
        "english-heuristic",
        "uncertain",
        "document-inherited",
        "user-specified",
        "script-compatible-hint"
      ]
    }
  },
  "required": [
    "language",
    "sourceLanguage",
    "reason"
  ],
  "additionalProperties": false,
  "$id": "https://pagelingo.dev/schemas/web-language/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
