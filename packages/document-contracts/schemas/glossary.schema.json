{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "target": {
            "type": "string",
            "maxLength": 240
          },
          "policy": {
            "type": "string",
            "enum": [
              "keep",
              "translate",
              "first-bilingual",
              "prefer-source"
            ]
          },
          "domain": {
            "type": "string",
            "enum": [
              "all",
              "machine-learning",
              "software-engineering",
              "physics",
              "general-technical"
            ]
          }
        },
        "required": [
          "source",
          "target",
          "policy",
          "domain"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "revision",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://pagelingo.dev/schemas/glossary/1",
  "$comment": "Shape validation only. Reader graph, translation references, SDK replay, resource closure and actual byte hashes require their dedicated validators."
}
