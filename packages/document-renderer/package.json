{
  "name": "@pagelingo/document-renderer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "static",
    "compat",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/generate-static-catalog.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pagelingo/document-contracts": "0.3.0",
    "@pagelingo/translation-core": "0.4.0",
    "katex": "0.19.1",
    "@pagelingo/web-capture": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
