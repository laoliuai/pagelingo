# Only scripts/check-llm.mjs reads this local configuration. Never bundled by Vite.
PAGELINGO_LLM_BASE_URL=https://api.example.com/v1
PAGELINGO_LLM_MODEL=your-model-id
PAGELINGO_LLM_API_KEY=
# Optional: json-object (default), json-schema, text
PAGELINGO_LLM_RESPONSE_FORMAT=json-object

# Optional document service: injected into its process; never read by unit tests.
PAGELINGO_SITE_MODE=local
PAGELINGO_SITE_ORIGIN=http://127.0.0.1:5174
PAGELINGO_SERVICE_HOST=127.0.0.1
PAGELINGO_SERVICE_PORT=4320
PAGELINGO_DATA_DIR=./.local/document-service
DATABASE_URL=postgresql://pagelingo:replace-me@127.0.0.1:5432/pagelingo
# Optional directory for the later web build.
PAGELINGO_WEB_DIR=
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# JSON maps key IDs to canonical base64-encoded 32-byte keys. Retain old keys during rotation.
PAGELINGO_MASTER_KEY_ID=primary
PAGELINGO_MASTER_KEYS_JSON={"primary":"replace-with-generated-base64-key"}
PAGELINGO_MAX_PDF_BYTES=268435456
