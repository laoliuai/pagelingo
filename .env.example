# Local LLM tools use PAGELINGO_LLM_*; site commands use separate variables. Never bundled by Vite.
PAGELINGO_LLM_BASE_URL=https://api.example.com/v1
PAGELINGO_LLM_MODEL=your-model-id
PAGELINGO_LLM_API_KEY=
# Optional: json-object (default), json-schema, text
PAGELINGO_LLM_RESPONSE_FORMAT=json-object

# Optional document service: injected into its process; never read by unit tests.
PAGELINGO_SITE_MODE=local
PAGELINGO_SITE_ORIGIN=http://127.0.0.1:4320
# Development with Vite: change origin to http://127.0.0.1:5174
PAGELINGO_SERVICE_HOST=127.0.0.1
PAGELINGO_SERVICE_PORT=4320
PAGELINGO_DATA_DIR=./data/document-service
# Generate both values without printing credentials; see docs/learning-site-install.md.
POSTGRES_PASSWORD=
DATABASE_URL=
# Optional absolute path to apps/web/dist for a standalone same-origin service.
PAGELINGO_WEB_DIR=
# Run npm run site:keygen to add missing keyring values to ignored .env.local.
# Keep existing keys during rotation. Never paste secrets into this example.
PAGELINGO_MAX_PDF_BYTES=268435456
