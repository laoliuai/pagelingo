# Documentation template only. The CLI never loads this file or the site's .env.local.
# Supply the provider URL/model through --base-url and --model.
PAGELINGO_LLM_BASE_URL=https://provider.example.invalid/v1
PAGELINGO_LLM_MODEL=YOUR_MODEL_ID
# Set locally through your shell or secret manager; never pass a key as a CLI flag.
PAGELINGO_LLM_API_KEY=
# Optional strict partial JSON; structural ceilings may only be lowered.
PAGELINGO_BUNDLE_LIMITS_JSON={}
PAGELINGO_MAX_PDF_BYTES=268435456
